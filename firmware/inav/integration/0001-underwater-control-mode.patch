+/*
+ * underwater_allocator.h 鈥斺€?閫愭绾挎€у寲 + 鏈夌晫鏈€灏忎簩涔樼殑鑱斿悎鎺ㄥ姏/鍊捐浆瑙掑垎閰?+ *
+ * 涓?control/cm_uav/constrained_allocation.py 閲囩敤鍚屼竴妯″瀷涓庝唬浠凤細鎺у埗鏁堢巼鐭╅樀
+ * 鐢辨帹杩涘嚑浣曪紙geometry.py锛夊敮涓€纭畾锛屽垎閰嶅櫒鍦ㄤ换鍔¤酱鏉冮噸銆佷粙璐ㄦ帹鍔涜竟鐣屻€佹寚浠?+ * 骞呭€?鍙樺寲鐜囩害鏉熶笌宸茬煡鎺ㄥ姏鏁堣兘涓嬫眰瑙ｆ墽琛岄噺銆?+ *
+ * 璇ュ疄鐜板湪瀹氱偣鏈轰笂浠ャ€屽姞鏉冩瑙勬柟绋?+ 鎶曞奖鏈夌晫姝?+ 鍥炴函绾挎悳绱€嶈繎浼?Python 鐨?+ * 甯︾晫鏈€灏忎簩涔橈紙BVLS锛夛紝涓嶄緷璧?SVD / 鍔ㄦ€佸唴瀛樸€?+ */
+#pragma once
+
+#include "underwater_params.h"
+
+typedef struct uw_allocation_s {
+    float command[UW_NUM_ACTUATORS];      /* 瀹為檯鎸囦护 [T1..T4, th1..th4] */
+    float achieved_wrench[UW_NUM_WRENCH]; /* 妯″瀷瀹炵幇鐨勫箍涔夊姏 */
+    float residual[UW_NUM_WRENCH];        /* target - achieved */
+    float normalized_error;               /* 鍔犳潈娈嬪樊鑼冩暟 */
+    int local_rank;                        /* 灞€閮ㄦ晥鐜囩煩闃电З锛?=5锛?*/
+    int active_bounds;                     /* 瑙︾晫鐨勬墽琛岄噺涓暟 */
+    int iterations;                        /* 瀹為檯杩唬娆℃暟 */
+    int forced_projection;                 /* 鏈懆鏈熸槸鍚﹀洜杈圭晫鍙樺寲琚姇褰?*/
+} uw_allocation_t;
+
+typedef struct uw_allocator_s {
+    const uw_vehicle_t *vehicle;
+    float previous[UW_NUM_ACTUATORS];      /* 涓婂懆鏈熸寚浠?*/
+    int has_previous;
+} uw_allocator_t;
+
+void uw_allocator_init(uw_allocator_t *a, const uw_vehicle_t *vehicle);
+
+/* 娓呴浂鍘嗗彶鎸囦护锛岄噸鏂板洖鍒颁腑浣嶃€?*/
+void uw_allocator_reset(uw_allocator_t *a);
+
+/*
+ * 姹傝В鏈懆鏈熸墽琛岄噺銆?+ *   target       : 鏈熸湜骞夸箟鍔?(6,)
+ *   medium       : 褰撳墠浠嬭川锛堝喅瀹氭帹鍔涜竟鐣岋級
+ *   dt           : 鍛ㄦ湡闂撮殧 s
+ *   health       : 鍥涜矾宸茬煡鎺ㄥ姏鏁堣兘 [0,1]锛圢ULL 瑙嗕负鍏?1锛?+ *   air_fraction : 绌轰腑鎺堟潈锛?=瀹屽叏绌轰腑锛堝€捐浆鍥炰腑锛夛紝0=瀹屽叏姘翠腑
+ *   out          : 杈撳嚭鍒嗛厤缁撴灉
+ */
+void uw_allocate(uw_allocator_t *a, const float target[UW_NUM_WRENCH],
+                 uw_medium_t medium, float dt, const float health[UW_NUM_ROTORS],
+                 float air_fraction, uw_allocation_t *out);
